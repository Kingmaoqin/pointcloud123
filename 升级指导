## 3.4 registration/predictor.py（Gate 2 核心）

```python
def degeneracy(points, normals, centroid):            # 公式(38)
    lever = np.cross(points - centroid, normals)
    J = np.hstack([normals, lever])                   # (K,6)
    H = J.T @ J
    Ht, Hr = H[:3, :3], H[3:, 3:]
    Hn = np.block([[Ht/np.trace(Ht), np.zeros((3,3))],
                   [np.zeros((3,3)), Hr/np.trace(Hr)]])
    lam = np.linalg.eigvalsh(Hn)
    return 1.0 - lam[0] / lam[-1]

def r_reg(overlap, degen, o_min=0.30, gamma=1.0):     # 公式(39)
    return np.clip(overlap / o_min, 0, 1) * (1 - degen) ** gamma
```
