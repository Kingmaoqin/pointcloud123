def paired_permutation(x, y, n=10000, seed=0):        # 双侧配对置换
    d = x - y; rng = np.random.default_rng(seed); t0 = d.mean()
    ts = [(d * rng.choice([1, -1], d.size)).mean() for _ in range(n)]
    return float((np.abs(ts) >= abs(t0)).mean())

def holm(pvals):
    order = np.argsort(pvals); m = len(pvals)
    adj = np.empty(m); run = 0.0
    for rank, idx in enumerate(order):
        run = max(run, (m - rank) * pvals[idx]); adj[idx] = min(1.0, run)
    return adj

