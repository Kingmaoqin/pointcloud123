## 3.2 occlusion/raycast.py（Gate 1 核心）

```python
class OcclusionOracle:
    def __init__(self, vertices: np.ndarray, triangles: np.ndarray,
                 tri_to_patch: np.ndarray):        # (T,) 三角面→patch_id
        import open3d as o3d
        self.scene = o3d.t.geometry.RaycastingScene()
        mesh = o3d.t.geometry.TriangleMesh(
            o3d.core.Tensor(vertices.astype(np.float32)),
            o3d.core.Tensor(triangles.astype(np.uint32)))
        self.geom_id = self.scene.add_triangles(mesh)
        self.tri_to_patch = tri_to_patch

    def visibility(self, origin, samples, target_patch, eps=0.01) -> float:
        d = samples - origin[None, :]
        dist = np.linalg.norm(d, axis=1)
        rays = np.hstack([np.tile(origin, (len(samples), 1)),
                          d / dist[:, None]]).astype(np.float32)
        ans = self.scene.cast_rays(o3d.core.Tensor(rays))
        t_hit = ans['t_hit'].numpy()                  # 首命中距离
        prim  = ans['primitive_ids'].numpy()          # 首命中三角面id
        ok = np.isfinite(t_hit) & (t_hit >= dist - eps) & \
             (self.tri_to_patch[np.minimum(prim, len(self.tri_to_patch)-1)]
              == target_patch)
        return float(ok.mean())                       # 公式(28)
```
说明：`cast_rays` 返回 `t_hit` 与 `primitive_ids`，即 first-hit 语义（Embree BVH，【事实】Open3D 0.19 API）。批量化：一个候选站对全部目标 Patch 的采样点拼成单次 cast_rays（射线数 10⁴–10⁵/站，CPU 毫秒–百毫秒级）。

